# Copy this file to .env for local overrides. Never commit the real .env.
DJANGO_SECRET_KEY=replace-me-for-any-public-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The app is UK-first by default.
DEFAULT_CURRENCY=GBP
DEFAULT_REGION=GB
SITE_URL=http://127.0.0.1:8000

# SQLite is the low-resource default. WAL + immediate write transactions are
# enabled automatically. Uncomment DATABASE_URL for a larger deployment.
DB_CONN_MAX_AGE=60
# DATABASE_URL=postgresql://game_tracker:password@127.0.0.1:5432/game_tracker

# Default local cache is bounded in memory. Increase only for a large catalogue.
CACHE_MAX_ENTRIES=800
# For shared production caching, uncomment both lines and run Redis.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# Hard per-process I/O caps. Lower these on tiny servers; defaults total 17.
PAGE_IO_WORKERS=6
BUNDLE_IO_WORKERS=5
UK_IO_WORKERS=6

# Optional: the web app runs without Redis; these enable background refreshes.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_IGNORE_RESULT=True
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=100
# Celery Beat refreshes every 12 hours by default; detail pages remain live.
PRICE_REFRESH_INTERVAL_SECONDS=43200

# Local development prints email alerts in the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Game Price Tracker <noreply@localhost>
